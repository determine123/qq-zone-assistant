{
  "manifest_version": 3,
  "name": "QQ相册备份助手",
  "version": "2.5.3",
  "description": "输入 QQ 空间相册地址直接下载，支持暂停、重试和排除规则。",
  "action": {
    "default_icon": {
      "16": "src/assets/icon.png",
      "48": "src/assets/icon.png",
      "128": "src/assets/icon.png"
    }
  },
  "icons": {
    "16": "src/assets/icon.png",
    "48": "src/assets/icon.png",
    "128": "src/assets/icon.png"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.qzone.qq.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
